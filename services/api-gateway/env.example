# API Gateway environment (Phase 3)
# Copy to services/api-gateway/.env or export before `npm run gateway`

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (shared with apps/web via packages/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reelgrabber?schema=public

# BullMQ (Phase 5)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=reelgrabber

# Dispatch queued jobs to platform workers (Phase 6)
ENABLE_JOB_PROCESSOR=true
INSTAGRAM_WORKER_URL=http://localhost:8001

LOG_LEVEL=debug

# Observability (Phase 8)
SERVICE_NAME=api-gateway
METRICS_ENABLED=true
# SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
