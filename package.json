{
  "name": "reelgrabber",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade media processing platform (Turborepo monorepo).",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web": "npm run dev --workspace apps/web",
    "gateway": "npm run dev --workspace @reelgrabber/api-gateway",
    "db:migrate": "npm run db:migrate --workspace @reelgrabber/database",
    "db:generate": "npm run db:generate --workspace @reelgrabber/database",
    "db:studio": "npm run db:studio --workspace @reelgrabber/database",
    "observability": "docker compose --profile observability up -d",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0"
  }
}
