# Root infrastructure environment (used by docker-compose).
# Copy to .env at the repo root: `cp .env.example .env`
# Application-level env lives in apps/web/.env (see apps/web/env.example).

# Postgres (docker-compose)
POSTGRES_DB=reelgrabber
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection strings for services consuming the infra above
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelgrabber?schema=public"
REDIS_URL="redis://localhost:6379"
