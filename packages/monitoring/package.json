{
  "name": "@reelgrabber/monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "Observability helpers — Prometheus metrics, Sentry, OpenTelemetry",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^8.47.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "files": ["dist"]
}
